<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>Checklist Giornaliera — Piano Nutrizionale</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  :root{
    --paper:#EFECE4;
    --ink:#2B2A26;
    --line:#C7C2B5;
    --accent:#5B6B4F;
    --accent-soft:#E4E7DC;
    --warn:#8A5A3B;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;
    line-height:1.5;
    padding:32px 16px 64px;
  }
  @media (max-width:380px){
    body{padding:20px 12px 48px;}
    h1{font-size:1.3rem;}
    li{font-size:0.9rem;}
  }
  .sheet{
    max-width:640px;
    margin:0 auto;
  }
  h1{
    font-size:1.5rem;
    font-weight:600;
    letter-spacing:0.01em;
    margin:0 0 4px;
    border-bottom:2px solid var(--ink);
    padding-bottom:10px;
  }
  .sub{
    font-size:0.85rem;
    color:#6b6a63;
    margin:0 0 16px;
  }
  .day-type-selector {
    background: #e2e5d9;
    border: 1px solid var(--line);
    padding: 10px 14px;
    border-radius: 4px;
    margin-bottom: 22px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.9rem;
  }
  .day-type-selector select {
    background: #fff;
    border: 1px solid var(--line);
    padding: 4px 8px;
    font-family: inherit;
    font-size: 0.9rem;
    border-radius: 4px;
  }
  .note{
    background:var(--accent-soft);
    border-left:3px solid var(--accent);
    padding:12px 14px;
    font-size:0.88rem;
    margin:0 0 22px;
    border-radius:2px;
  }
  .note strong{color:var(--warn);}
  section{margin-bottom:24px;}
  h2{
    font-size:1rem;
    font-weight:600;
    margin:0 0 4px;
    display:flex;
    justify-content:space-between;
    align-items:baseline;
  }
  h2 .hint{
    font-size:0.72rem;
    font-weight:400;
    font-style:italic;
    color:#8a887f;
  }
  h3{
    font-size:0.82rem;
    font-weight:600;
    text-transform:none;
    margin:14px 0 6px;
    color:#55534b;
  }
  ul{list-style:none;margin:0;padding:0;}
  li{
    display:flex;
    align-items:flex-start;
    gap:10px;
    padding:6px 4px;
    border-bottom:1px dotted var(--line);
    font-size:0.95rem;
  }
  li:last-child{border-bottom:none;}
  input[type=checkbox]{
    width:17px;height:17px;
    margin-top:2px;
    accent-color:var(--accent);
    flex-shrink:0;
  }
  .tag{
    font-size:0.72rem;
    color:#8a887f;
    font-style:italic;
    margin-left:6px;
  }
  .oil-auto{
    transition:background 0.3s ease;
  }
  .oil-auto.flagged{
    background:var(--accent-soft);
    border-radius:4px;
  }
  .diary label{
    display:block;
    margin:10px 0 4px;
    font-size:0.9rem;
  }
  .diary .row{display:flex;gap:18px;align-items:center;margin-bottom:8px;}
  .diary input[type=text], .diary input[type=number]{
    border:none;
    border-bottom:1px solid var(--ink);
    background:transparent;
    font-family:inherit;
    font-size:0.95rem;
    padding:2px 4px;
    width:100%;
  }
  .scale{margin:6px 0 14px;}
  .scale li{
    padding:4px 4px 4px 10px;
    font-size:0.88rem;
    border-bottom:1px dotted var(--line);
    border-left:3px solid transparent;
  }
  .scale input[type=checkbox]{width:15px;height:15px;}
  .scale .dot{
    display:inline-block;
    width:9px;height:9px;
    border-radius:50%;
    margin-right:8px;
    flex-shrink:0;
    align-self:center;
  }
  .scale li[data-sev="red"]{border-left-color:#A6503A;}
  .scale li[data-sev="yellow"]{border-left-color:#C79A3B;}
  .scale li[data-sev="green"]{border-left-color:#5B6B4F;}
  .scale .dot.red{background:#A6503A;}
  .scale .dot.yellow{background:#C79A3B;}
  .scale .dot.green{background:#5B6B4F;}
  .actions{
    display:flex;
    gap:10px;
    margin-top:30px;
    flex-wrap:wrap;
  }
  .reset, .save-pdf, .save-cloud{
    font-size:0.8rem;
    background:none;
    border:1px solid var(--line);
    padding:6px 12px;
    border-radius:4px;
    cursor:pointer;
    color:#6b6a63;
  }
